[Unit]
Description=hwtest Rack Server (pi5-mcc-intg-a)
Documentation=https://github.com/czalinski/hwtest
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=hwtest
Group=hwtest
WorkingDirectory=/opt/hwtest

# Optional settings in /etc/hwtest/rack.env, e.g.
#   HWTEST_RACK_SERIAL=001                  (calibration from /etc/hwtest/racks)
#   HWTEST_NATS_URL=nats://localhost:4222   (stream telemetry to NATS)
EnvironmentFile=-/etc/hwtest/rack.env

# Rust rack server (libdaqhats is loaded at runtime)
ExecStart=/opt/hwtest/bin/hwtest-rack serve /opt/hwtest/configs/pi5_mcc_intg_a_rack.yaml --host 0.0.0.0 --port 8080

# Restart policy
Restart=always
RestartSec=10

# Security hardening (while allowing hardware access)
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/hwtest /etc/hwtest
PrivateTmp=true

# Hardware access - required for MCC HATs
SupplementaryGroups=spi gpio i2c

[Install]
WantedBy=multi-user.target

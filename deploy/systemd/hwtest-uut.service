[Unit]
Description=HWTest UUT Simulator
After=network.target can0.service
Wants=can0.service

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi

# Rust UUT simulator. Install it with:
#   scripts/build_release.sh --target aarch64        (on the dev machine)
#   sudo install -m 0755 dist/aarch64/hwtest-uut-sim /usr/local/bin/
#
# Cyclic failure injection:
# - failure-delay: 300s (5 minutes) before failure activates
# - failure-duration: 10s failure stays active before recovery
# - failure-offset: +1.0V added to DAC output during failure
ExecStart=/usr/local/bin/hwtest-uut-sim \
    --port 8080 \
    --can-interface can0 \
    --waveshare-adda \
    --no-gpio \
    --failure-delay 300 \
    --failure-duration 10 \
    --failure-offset 1.0

Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
